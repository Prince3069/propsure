rules_version = '2';

// Propsure Firestore Rules — Phase 1 (P0 correctness & trust)
//
// Written fresh, since no existing rules file was available to build on.
// Deploy with: firebase deploy --only firestore:rules
//
// The guiding principle throughout, straight from the code review: the
// Flutter client is UNTRUSTED. Every field that influences trust badges,
// search ranking, payments, or moderation must be unwritable by a normal
// signed-in user, no matter what the app itself does or doesn't check.
// These rules are the actual enforcement; the client-side allowlists in
// listing_repository.dart etc. are a second, defense-in-depth layer, not
// the real barrier.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isReviewer() {
      return isSignedIn() && (request.auth.token.reviewer == true || request.auth.token.admin == true);
    }
    // True only if `keys` are entirely absent from the incoming write's
    // diff against the existing document — i.e. the caller isn't trying
    // to change any of them at all. Used to let an owner update their own
    // document EXCEPT a specific set of trust-sensitive fields.
    function unchanged(field) {
      return !(field in request.resource.data) ||
             (resource != null && request.resource.data[field] == resource.data[field]);
    }

    // ── users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        // A new account can never be born admin, pre-verified, or with a
        // role other than the basic self-service ones.
        && request.resource.data.role in ['tenant', 'agent', 'landlord']
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('verificationStatus', 'none') == 'none';
      allow update: if isOwner(userId)
        // "Users cannot change ... through generic update calls" —
        // role, verification, and admin-adjacent fields are frozen from
        // the client's perspective. The one exception: a user MAY move
        // their OWN verificationStatus from 'none' to 'pending' (submitting
        // a request), never to 'approved'.
        && unchanged('role')
        && unchanged('isVerified')
        && unchanged('verifiedAt')
        && unchanged('verifiedBy')
        && unchanged('verificationExpiresAt')
        && unchanged('premiumPlan')
        && unchanged('premiumExpiresAt')
        && (unchanged('verificationStatus') ||
            (resource.data.get('verificationStatus', 'none') == 'none'
             && request.resource.data.verificationStatus == 'pending'))
        || isAdmin();
      allow delete: if false; // account deletion goes through a Cloud Function (data cleanup)
    }

    // ── listings ─────────────────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if true; // public marketplace data
      allow create: if isSignedIn()
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('isFeatured', false) == false
        && request.resource.data.get('verificationStatus', 'none') == 'none'
        && request.resource.data.status in ['active', 'pending_review', 'draft'];
      allow update: if isSignedIn() && resource.data.agentId == request.auth.uid
        // Owner can edit their own listing's content, but none of the
        // trust/entitlement/ownership fields — those are Cloud
        // Function-only. This mirrors kOwnerEditableListingFields in
        // listing_repository.dart; the client allowlist can be edited by
        // mistake, this rule cannot.
        && unchanged('agentId')
        && unchanged('isVerified')
        && unchanged('isFeatured')
        && unchanged('featuredUntil')
        && unchanged('verificationStatus')
        && unchanged('verifiedAt')
        && unchanged('verifiedBy')
        && unchanged('verificationExpiresAt')
        && unchanged('viewCount')
        && unchanged('inquiryCount')
        // Owner-safe status transitions only. 'archived' is included here
        // (Phase 2 soft-delete) alongside the archivedAt/archivedBy stamp
        // — an owner CAN set those two, but only to themselves/now, never
        // to a different uid (that would be forging who archived it).
        // Owner-safe status transitions. 'archived' is Phase 2 soft-delete;
        // 'draft' -> 'active'/'paused' is Phase 3's bulk-import publish
        // flow (BulkUploadScreen creates rows as 'draft', the agent
        // publishes each one from My Listings > Drafts after adding photos).
        && (unchanged('status') || request.resource.data.status in ['active', 'paused', 'rented', 'archived', 'draft'])
        && (unchanged('archivedBy') || request.resource.data.archivedBy == request.auth.uid || request.resource.data.archivedBy == null)
        || isAdmin() || isReviewer();
      allow delete: if isSignedIn() && resource.data.agentId == request.auth.uid || isAdmin();

      // Per-viewer view-count dedup marker (see incrementViewOnce in
      // listing_repository.dart). A viewer can only ever create/read
      // their OWN marker — never another user's, and never delete or
      // rewrite one once it exists, which is what makes the count
      // tamper-resistant from the client side.
      match /viewedBy/{viewerId} {
        allow read: if isSignedIn() && request.auth.uid == viewerId;
        allow create: if isSignedIn() && request.auth.uid == viewerId;
        allow update, delete: if false;
      }
    }

    // ── verification_requests ────────────────────────────────────────────
    match /verification_requests/{requestId} {
      // Applicants can read their own requests; reviewers/admins can read
      // any (to review them). No one else — these reference private
      // identity documents.
      allow read: if isSignedIn() &&
        (resource.data.applicantId == request.auth.uid || isReviewer());
      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted'];
      // A user may only edit their OWN request, and only while it's still
      // a draft — once submitted, only a reviewer (via the
      // reviewVerificationRequest Cloud Function, which uses the Admin
      // SDK and bypasses these rules entirely) can move it further.
      allow update: if isSignedIn()
        && resource.data.applicantId == request.auth.uid
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted'];
      allow delete: if false;
    }

    // ── transactions ─────────────────────────────────────────────────────
    match /transactions/{reference} {
      // Read-only for the owning user (so the UI can watch its own
      // payment status); NO client writes at all, ever. Every write comes
      // from initializePaystackTransaction / paystackWebhook via the
      // Admin SDK, which is not subject to these rules. This is the fix
      // for "the client creates a pending transaction document with
      // client-supplied amount... before calling the function."
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── bookings ──────────────────────────────────────────────────────────
    // Phase 2: enforces WHO can move a booking through WHICH transition,
    // not just that the reader/writer is one of the two participants.
    // Mirrors the pending -> confirmed/rejected -> completed/cancelled
    // state machine from booking_repository.dart's confirmBooking/
    // rejectBooking/cancelBooking/completeBooking.
    match /bookings/{bookingId} {
      function isTenant() { return resource.data.userId == request.auth.uid; }
      function isAgentOwner() { return resource.data.agentId == request.auth.uid; }
      function newStatus() { return request.resource.data.status; }
      function oldStatus() { return resource.data.status; }

      allow read: if isSignedIn() && (isTenant() || isAgentOwner() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (isTenant() || isAgentOwner())
        && unchanged('userId') && unchanged('agentId') && unchanged('listingId')
        && (
          // Only the agent being booked can confirm or reject a pending request.
          (isAgentOwner() && oldStatus() == 'pending' && newStatus() in ['confirmed', 'rejected']) ||
          // Only the agent can mark a confirmed viewing as completed.
          (isAgentOwner() && oldStatus() == 'confirmed' && newStatus() == 'completed') ||
          // Either side can cancel while it's still pending or confirmed —
          // a tenant backing out or an agent who can no longer host it.
          ((isTenant() || isAgentOwner()) && oldStatus() in ['pending', 'confirmed'] && newStatus() == 'cancelled') ||
          // Non-status edits (e.g. isRated) with no status change at all.
          unchanged('status')
        )
        || isAdmin();
      allow delete: if false;
    }

    // ── chats / messages ──────────────────────────────────────────────────
    match /chats/{chatId} {
      // FIELD NAME FIX: ChatModel actually stores `participantIds`, not
      // `participants` — the first draft of this rule checked a field
      // that doesn't exist, which would have silently denied every read.
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('participantIds', []);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.get('participantIds', []);
      // A participant may update the chat document ONLY to add/remove
      // themselves from blockedBy/mutedBy (Phase 2 block/mute), or to
      // archive it for themselves — never to touch the other person's
      // presence in those arrays, and never participantIds/listingId.
      allow update: if isSignedIn() && request.auth.uid in resource.data.get('participantIds', [])
        && unchanged('participantIds') && unchanged('listingId')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedBy', 'mutedBy', 'isArchived', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participantIds', []);
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid
          // Can't send into a chat you've blocked — mirrors the input bar
          // being hidden client-side; this is the real enforcement.
          && !(request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('blockedBy', []));
        allow update, delete: if false;
      }
    }

    // ── enquiries ──────────────────────────────────────────────────────────
    // Phase 3 — general enquiries distinct from bookings (see
    // EnquiryRepository). Same shape of rule as bookings: participants
    // only, no impersonation, no changing who the enquiry is between.
    match /enquiries/{enquiryId} {
      allow read: if isSignedIn() &&
        (resource.data.enquirerId == request.auth.uid || resource.data.agentId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.enquirerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.agentId == request.auth.uid
        && unchanged('enquirerId') && unchanged('agentId') && unchanged('listingId')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseState', 'respondedAt']);
      allow delete: if false;
    }

    // ── saved_searches ────────────────────────────────────────────────────
    // Phase 3 — backs SavedSearchRepository. A user's saved searches are
    // theirs alone; the matching Cloud Function (checkSavedSearches) uses
    // the Admin SDK and isn't subject to this rule.
    match /saved_searches/{searchId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    // Phase 2: backs ReportRepository. Anyone signed in can file one;
    // only the reporter can read their own; a moderation queue for
    // reviewing ALL reports is a privileged admin-tool concern, not this
    // consumer app, so there's deliberately no broad read rule here.
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin() || isReviewer());
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin() || isReviewer();
      allow delete: if false;
    }

    // ── notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Only Cloud Functions create notifications; a user may mark their
      // own as read, nothing else.
      allow create, delete: if false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // ── reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.reviewerId == request.auth.uid;
    }
  }
}
