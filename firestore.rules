rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ───────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isAgent() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['agent', 'landlord', 'admin'];
    }

    // ─── USERS ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── LISTINGS ──────────────────────────────────────────────────────────
    match /listings/{listingId} {
      // Anyone can read active listings
      allow read: if resource.data.status == 'active' || isAuth();

      // Only agents/landlords/admins can create
      allow create: if isAgent() &&
        request.resource.data.agentId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.price is number &&
        request.resource.data.price > 0;

      // Owner or admin can update
      allow update: if (isOwner(resource.data.agentId) || isAdmin());

      // Only admin can delete
      allow delete: if isAdmin();
    }

    // ─── CHATS ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isAuth() &&
          (request.auth.uid == resource.data.senderId || 
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
        allow delete: if isAdmin();
      }
    }

    // ─── BOOKINGS ──────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAuth() &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.agentId || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.agentId || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── REVIEWS ───────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.reviewerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── NOTIFICATIONS ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAdmin();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
