rules_version = '2';

// Propsure Storage Rules — Phase 1
// Deploy with: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isReviewer() {
      return isSignedIn() && (request.auth.token.reviewer == true || request.auth.token.admin == true);
    }

    // ── Public listing media — anyone can read, only the uploading agent
    // can write (matched by listing ownership isn't checkable here since
    // Storage rules can't read Firestore cheaply per-request at scale, so
    // this trusts Firebase Auth's uid folder convention already used by
    // ListingRepository: listings/images/{listingId}/...). Combined with
    // the Firestore rule that only the owning agentId can ever attach new
    // image URLs to a listing document, an attacker who somehow uploads
    // to a path they don't own still can't get it referenced anywhere.
    match /listings/images/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /listings/videos/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/avatars/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Verification documents — PRIVATE. This is the fix for "upload
    // documents to private Storage paths with security rules... do not
    // expose identity documents to tenants or other users." Only the
    // uploading applicant (write-once — no update/delete once submitted)
    // and an authorized reviewer (read-only, and only ever via a signed
    // URL minted by getReviewDocumentUrl, never a direct client read of
    // this path) can touch these files. No one else, ever.
    match /verification/{uid}/{requestId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isReviewer());
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
